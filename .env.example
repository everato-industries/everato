# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=piush
DB_PASSWORD=root_access
DB_NAME=everato
DB_SSLMODE=disable

# Complete Database URL
DB_URL=postgres://piush:root_access@localhost:5432/everato?sslmode=disable

# Migration Configuration
MIGRATIONS_DIR=internal/db/migrations

# Server Configuration
PORT=8080
ENV=development
API_URL=http://localhost:8080/api/v1
JWT_SECRET=SUPER_SECRET_KEY_CHANGE_IN_PRODUCTION
JWT_EXPIRATION=12h

# ─────────────────────────────────────────────────────────────────────────────
# Payment Gateway Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Select active provider: "razorpay", "stripe", or "cashfree"
# Can also be set in config.yaml under payment.provider
PAYMENT_PROVIDER=razorpay
PAYMENT_CURRENCY=INR

# Option 1: Razorpay Configuration (required when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Option 2: Stripe Configuration (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Option 3: Cashfree Configuration (required when PAYMENT_PROVIDER=cashfree)
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=TEST # Options: TEST or PRODUCTION

# Kafka Configuration (Optional)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=events

# Zookeeper Configuration (Optional)
ZOOKEEPER_URL=localhost:2181

# SMTP Configuration for Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
